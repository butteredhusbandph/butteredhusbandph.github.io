      <pubDate>Thu, 23 Apr 2026 15:50:04 +0800</pubDate>
      <guid>//localhost:1313/posts/ansible/ansible-automation-platform-ex467/</guid>
      <description>&lt;h1 id=&#34;ex467-exam-objectives&#34;&gt;EX467 Exam Objectives&lt;/h1&gt;&#xA;&lt;h2 id=&#34;manage-automation-content&#34;&gt;Manage automation content&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a href=&#34;//localhost:1313/ansible/ansible-automation-contents/#upload-a-collection-to-automation-hub&#34;&gt;Upload a collection to automation hub&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;//localhost:1313/ansible/aap-private-execution-environment/#uploading-content-collections-to-private-automation-hub&#34;&gt;Upload an execution environment to automation hub&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;manage-access-to-ansible-automation-platform&#34;&gt;Manage access to Ansible Automation Platform&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Create automation controller &lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-access-management/#users&#34;&gt;users&lt;/a&gt; and &lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-access-management/#teams&#34;&gt;teams&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-access-management/#associate-users-in-teams&#34;&gt;Associate users with teams associations&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-access-management/#roles&#34;&gt;Configure organization roles&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;Configure user types&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;manage-inventories-and-credentials&#34;&gt;Manage inventories and credentials&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Create host groups&lt;/li&gt;&#xA;&lt;li&gt;Assign systems to host groups&lt;/li&gt;&#xA;&lt;li&gt;Configure access to inventories&lt;/li&gt;&#xA;&lt;li&gt;Configure inventory variables&lt;/li&gt;&#xA;&lt;li&gt;Create and configure machine credentials to access hosts&lt;br&gt;&#xA;&lt;a href=&#34;../ansible-automation-platform-inventories&#34;&gt;Lab Referrence&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;manage-controller-projects&#34;&gt;Manage controller projects&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Create projects&lt;/li&gt;&#xA;&lt;li&gt;Create job templates&lt;/li&gt;&#xA;&lt;li&gt;Control user access to job templates&lt;/li&gt;&#xA;&lt;li&gt;Launch jobs&lt;br&gt;&#xA;&lt;a href=&#34;../ansible-automation-platform-execution&#34;&gt;Lab Referrence&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;manage-controller-workflows&#34;&gt;Manage controller workflows&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Create workflow templates&lt;/li&gt;&#xA;&lt;li&gt;Launch workflow jobs&lt;/li&gt;&#xA;&lt;li&gt;Configure workflow jobs for automatic approval&lt;br&gt;&#xA;&lt;a href=&#34;../ansible-automation-platform-execution&#34;&gt;Lab Referrence&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;manage-jobs&#34;&gt;Manage jobs&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-execution/#creating-job-template-survey&#34;&gt;Create a job template survey&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;Schedule jobs and manage &lt;a href=&#34;ansible/ansible-automation-platform-notifier/&#34;&gt;notifications&lt;/a&gt;&lt;br&gt;&#xA;&lt;a href=&#34;../ansible-automation-platform-execution&#34;&gt;Lab Referrence&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;interact-with-ansible-automation-platform-programmatically&#34;&gt;Interact with Ansible Automation Platform programmatically&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Understand how to use an API script to obtain required parameters for launching jobs&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-programmatically/&#34;&gt;Write an API scriptlet to launch a job&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;Use Ansible Content Collections&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;ansible/ansible-automation-platform-git-webhook/&#34;&gt;Configure a Git webhook&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;maintain-ansible-automation-platform&#34;&gt;Maintain Ansible Automation Platform&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Back up an instance of automation controller&lt;/li&gt;&#xA;&lt;li&gt;Back up an instance of Ansible Private Hub&lt;/li&gt;&#xA;&lt;li&gt;Troubleshooting&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;scale-an-ansible-automation-platform-deployment&#34;&gt;&lt;a href=&#34;//localhost:1313/ansible/ansible-automation-platform-mesh/&#34;&gt;Scale an Ansible Automation Platform deployment&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Install and configure automation mesh&lt;/li&gt;&#xA;&lt;li&gt;Extend automation mesh&lt;/li&gt;&#xA;&lt;li&gt;Create and manage instance groups&lt;/li&gt;&#xA;&lt;li&gt;Assign default instance groups to controller inventories or templates&lt;/li&gt;&#xA;&lt;li&gt;Run controller job templates in a specific instance group&lt;/li&gt;&#xA;&lt;li&gt;Run a job on segregated network&lt;/li&gt;&#xA;&lt;/ul&gt;</description>
